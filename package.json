{
  "name": "napominalka",
  "version": "0.3.0",
  "description": "Напоминалка — приложение с анимированными питомцами и напоминаниями о заботе о себе.",
  "main": "main.cjs",
  "author": "Best Practice AI",
  "homepage": "https://bestpracticeai.ru/",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node scripts/check-text.mjs && node --test test/exercises.test.cjs",
    "dist": "electron-builder --mac --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:mac:x64": "electron-builder --mac --x64 --publish never",
    "dist:win": "electron-builder --win --x64 --publish never",
    "dist:win:arm64": "electron-builder --win --arm64 --publish never",
    "dist:win:portable": "electron-builder --config electron-builder.portable.json --win --x64 --publish never",
    "dist:win:portable:arm64": "electron-builder --config electron-builder.portable.json --win --arm64 --publish never"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "ru.bestpracticeai.napominalka",
    "productName": "Напоминалка",
    "icon": "build/icon.png",
    "electronLanguages": [
      "ru",
      "en-US"
    ],
    "afterPack": "scripts/after-pack.cjs",
    "files": [
      "main.cjs",
      "preload.cjs",
      "lib/**/*",
      "src/**/*",
      "!src/*-harness.html",
      "assets/icons/**/*",
      "assets/brand/**/*",
      "assets/fonts/**/*",
      "assets/pets/*/spritesheet.webp",
      "assets/sounds/*.mp3",
      "assets/pet-reference-board.webp",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "Napominalka-${version}-${arch}.${ext}",
      "category": "public.app-category.healthcare-fitness",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Napominalka-${version}-${arch}-setup.${ext}"
    }
  }
}
