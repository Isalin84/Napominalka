{
  "appId": "ru.bestpracticeai.napominalka",
  "productName": "Напоминалка",
  "icon": "build/icon.png",
  "electronLanguages": ["ru", "en-US"],
  "afterPack": "scripts/after-pack.cjs",
  "files": [
    "main.cjs",
    "preload.cjs",
    "src/**/*",
    "assets/icons/**/*",
    "assets/pets/*/spritesheet.webp",
    "assets/sounds/*.mp3",
    "assets/pet-reference-board.webp",
    "package.json"
  ],
  "win": {
    "target": ["portable"],
    "artifactName": "Napominalka-${version}-${arch}-portable.${ext}"
  }
}
